{
  "name": "bakugo-kuryer-ios",
  "version": "1.0.0",
  "private": true,
  "description": "BakuGo Kuryer — iOS (App Store) tətbiqi, Capacitor ilə",
  "scripts": {
    "ios:add": "npx cap add ios",
    "ios:assets": "npx @capacitor/assets generate --ios --iconBackgroundColor '#000000' --iconBackgroundColorDark '#000000' --splashBackgroundColor '#000000' --splashBackgroundColorDark '#000000'",
    "ios:configure": "bash scripts/ios-configure.sh",
    "ios:sync": "npx cap sync ios",
    "ios:prepare": "npm run ios:add && npm run ios:assets && npm run ios:configure && npm run ios:sync",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@capacitor-firebase/messaging": "^7.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@capacitor/assets": "^3.0.5"
  }
}
